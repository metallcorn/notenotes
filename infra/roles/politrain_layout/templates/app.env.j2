# {{ ansible_managed }}
# Окружение politrain. Лежит на незашифрованном диске (см. tasks/main.yml),
# режим 0600. Путь БД — внутри volume, смонтированного в контейнер на /data
# (см. politrain_stack/templates/docker-compose.yml.j2).

SECRET_KEY={{ politrain_secret_key }}
MISTRAL_API_KEY={{ politrain_mistral_api_key }}
MISTRAL_MODEL={{ politrain_mistral_model }}
DEEPGRAM_API_KEY={{ politrain_deepgram_api_key }}
DATABASE_URL=sqlite:////data/politrain.db
ENVIRONMENT=production
# Сравнивается с username залогиненного юзера в БД (routers/auth.py,
# routers/admin.py) — отдельного пароля для админки нет, это не секрет
# отдельно от обычного логина/пароля пользователя.
ADMIN_USERNAME={{ politrain_admin_username }}
