# {{ ansible_managed }}
# Лежит ВНУТРИ LUKS-тома, режим 0600.
#
# Это ключевая деталь всей схемы шифрования: если бы пароль репозитория и
# ключи S4 лежали на незашифрованном диске, образ этого диска давал бы доступ
# к расшифровке всех бэкапов — и шифрование данных потеряло бы смысл.

RESTIC_PASSWORD={{ restic_password }}

# Задан явно по двум причинам.
# 1. systemd-юниты запускаются без $HOME, и restic падает с
#    "unable to locate cache directory: neither $XDG_CACHE_HOME nor $HOME".
# 2. Кэш хранит индексы репозитория — имена файлов и структуру каталогов,
#    то есть ровно те метаданные, ради сокрытия которых всё и шифруется.
#    Поэтому он внутри тома, а не в /var/cache на открытом диске.
RESTIC_CACHE_DIR={{ restic_cache_dir }}
{% if restic_backend == 's4' %}
RESTIC_REPOSITORY=s3:https://{{ restic_s4_endpoint }}/{{ restic_s4_bucket }}
AWS_ACCESS_KEY_ID={{ restic_s4_access_key }}
AWS_SECRET_ACCESS_KEY={{ restic_s4_secret_key }}
AWS_DEFAULT_REGION={{ restic_s4_region }}
{% else %}
RESTIC_REPOSITORY={{ restic_local_repo }}
{% endif %}
