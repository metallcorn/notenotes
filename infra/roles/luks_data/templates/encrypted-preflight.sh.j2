#!/bin/bash
# {{ ansible_managed }}
#
# Предохранитель от потери данных. Проверяет, что общий шифрованный том
# действительно смонтирован, ПЕРЕД любым запуском приложений.
#
# Docker САМ создаёт отсутствующие каталоги источника bind-mount. Если стек
# стартует при незамонтированном томе, Postgres увидит пустой каталог и
# проинициализирует НОВЫЙ кластер прямо в точке монтирования. После
# последующей разблокировки реальные данные окажутся скрыты под примонтированным
# томом, а приложение будет смотреть в пустую базу и выглядеть «работающим».
#
# Необязательный аргумент — подкаталог приложения, наличие которого тоже
# проверяется:  encrypted-preflight notenotes

set -euo pipefail

MOUNT="{{ encrypted_mount }}"
MARKER="$MOUNT/.encrypted-volume"
APP="${1:-}"

if [[ "{{ luks_enabled | lower }}" != "true" ]]; then
    exit 0
fi

if ! mountpoint -q "$MOUNT"; then
    echo "ОШИБКА: $MOUNT не является точкой монтирования." >&2
    echo "Шифрованный том закрыт. Сначала выполни: sudo encrypted-unlock" >&2
    exit 1
fi

if [[ ! -f "$MARKER" ]]; then
    echo "ОШИБКА: $MOUNT примонтирован, но маркер $MARKER отсутствует." >&2
    echo "Похоже, смонтирован не тот том. Запуск отменён." >&2
    exit 1
fi

if [[ -n "$APP" && ! -d "$MOUNT/$APP" ]]; then
    echo "ОШИБКА: каталог приложения $MOUNT/$APP отсутствует." >&2
    echo "Прогони соответствующий playbook, прежде чем запускать стек." >&2
    exit 1
fi

echo "Проверка пройдена: $MOUNT смонтирован${APP:+, каталог $APP на месте}."
