# {{ ansible_managed }}
# Лежит внутри LUKS-тома. Режим 0600.
POSTGRES_DB={{ postgres_db }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
# Данные в подкаталоге, а не в корне тома монтирования — стандартная практика
# официального образа postgres.
PGDATA=/var/lib/postgresql/data/pgdata
