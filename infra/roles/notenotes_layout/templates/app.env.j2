# {{ ansible_managed }}
# Окружение для будущего backend'а (ТЗ §2). Лежит внутри LUKS-тома, режим 0600.
# Имена сервисов — из docker-сети notenotes_internal.

DATABASE_URL=postgresql+asyncpg://{{ postgres_user }}:{{ postgres_password }}@postgres:5432/{{ postgres_db }}
REDIS_URL=redis://:{{ redis_password }}@redis:6379/0
SECRET_KEY={{ app_secret_key }}

UPLOAD_DIR=/data/uploads
{% if notenotes_tls_mode == 'acme' %}
PUBLIC_BASE_URL=https://{{ notenotes_domain }}
{% else %}
PUBLIC_BASE_URL=http://{{ ansible_default_ipv4.address }}
{% endif %}

# --- Заполняется по мере реализации фаз из ТЗ -------------------------------
# Фаза 2: AI-ассистент (ТЗ §10a/§10b). Mistral первым провайдером — за
# абстракцией (app/backend/app/llm/), подменяем на Gemini/OpenAI/Claude без
# правок вне llm/factory.py, если понадобится.
LLM_PROVIDER=mistral
LLM_API_KEY={{ llm_api_key }}
LLM_MODEL=mistral-large-latest
# OCR_API_KEY=
# TRANSCRIPTION_API_KEY=
#
# Веб-поиск: Tavily через абстракцию с подменяемым провайдером (ТЗ §10b).
# Предохранитель обязателен с первой версии (CLAUDE.md) — лимит поисков на
# один ход диалога, иначе агентный цикл сжигает месячный лимит Tavily разом.
TAVILY_API_KEY={{ tavily_api_key }}
WEB_SEARCH_MAX_CALLS_PER_TURN=5
#
# Голосовой ассистент (ТЗ §10a, §14). ASR — одноразовая транскрипция записи,
# не потоковая (Deepgram REST); TTS — Palabra (потоковый WebSocket, за
# абстракцией в app/backend/app/tts/).
ASR_PROVIDER=deepgram
DEEPGRAM_API_KEY={{ deepgram_api_key }}
WHISPER_API_KEY={{ whisper_api_key }}
TTS_PROVIDER=palabra
PALABRA_API_KEY={{ palabra_api_key }}
PALABRA_REGION=eu
#
# Telegram-бот как канал захвата заметок (ТЗ, Фаза 2 «Каналы») — обычный
# Bot API с вебхуком на {PUBLIC_BASE_URL}/api/telegram/webhook, НЕ MTProto.
# Без токена приложение просто не регистрирует вебхук, остальное не страдает.
TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}
TELEGRAM_BOT_USERNAME={{ telegram_bot_username }}
TELEGRAM_WEBHOOK_SECRET={{ telegram_webhook_secret }}
#
# Фаза 3: MTProto в изолированном контейнере (ТЗ §15.1) — полноценный доступ
# к аккаунту Telegram (чтение каналов, на которые подписан пользователь).
# Другая задача и другие риски, чем простой бот выше.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
#
# Web Push — уведомления вне открытой вкладки/закрытого приложения.
# Self-hosted VAPID-пара (не платформенный ключ вендора), генерируется
# один раз и не меняется (смена — все существующие подписки умрут).
VAPID_PRIVATE_KEY={{ vapid_private_key }}
VAPID_PUBLIC_KEY={{ vapid_public_key }}
VAPID_SUBJECT={{ vapid_subject }}
#
# Инвайт-код для /auth/register (внешний пентест 2026-08-14: регистрация
# была открыта всему интернету). Пусто — регистрация закрыта полностью.
REGISTRATION_INVITE_CODE={{ registration_invite_code }}
