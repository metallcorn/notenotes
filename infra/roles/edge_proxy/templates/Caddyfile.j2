# {{ ansible_managed }}
#
# Общий конфиг edge-прокси. Сайты отдельных приложений сюда НЕ пишутся:
# каждое приложение кладёт свой фрагмент в conf.d/, и добавление приложения
# не требует правки этого файла.

{% if notenotes_tls_mode == 'acme' %}
{
	email {{ notenotes_acme_email }}
}
{% else %}
{
	# Домены ещё не переведены на этот сервер — сертификат получить не на что.
	auto_https off
}
{% endif %}

import conf.d/*.caddy
