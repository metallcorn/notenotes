---
# Правило var-naming[no-role-prefix] требует префикса имени роли у ВСЕХ
# переменных внутри роли, включая временные register/set_fact. Для набора
# приватных ролей одного проекта это даёт шум вида
# stack_pg_ready / ssh_hardening_ssh_socket_activated без выигрыша в читаемости.
#
# Переменные, которые действительно составляют интерфейс роли и настраиваются
# извне, префикс имеют (docker_ingress_allowed_ports, firewall_allowed_ports,
# firewall_fail2ban_maxretry, restic_*). Отключается именно подправило,
# не var-naming целиком: проверка допустимых символов в именах остаётся.
skip_list:
  - var-naming[no-role-prefix]

exclude_paths:
  - .venv/
